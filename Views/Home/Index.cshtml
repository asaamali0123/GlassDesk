@{
    ViewData["Title"] = "Glass Desk — Transparent Governance, Traceable Civic Action";
}

<!-- ==========================================================================
     HERO SECTION
     ========================================================================== -->
<section class="py-5 text-white" style="background: linear-gradient(135deg, var(--gd-navy) 0%, var(--gd-navy-light) 100%); border-bottom: 3px solid var(--gd-teal);">
    <div class="container py-4">
        <div class="row align-items-center gy-4">
            <div class="col-lg-7">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3 text-white small" style="background-color: rgba(13, 148, 136, 0.25); border: 1px solid rgba(20, 184, 166, 0.4);">
                    <i class="bi bi-shield-check text-warning"></i>
                    <span class="fw-semibold">Civic Redressal & Transparency Platform</span>
                </div>
                <h1 class="display-4 fw-bold text-white mb-2 tracking-tight">
                    Glass Desk
                </h1>
                <p class="fs-4 text-white-50 fw-normal mb-3" style="color: #94a3b8 !important;">
                    Transparent Governance, Traceable Civic Action
                </p>
                <p class="lead text-light mb-4" style="max-width: 580px; font-size: 1.05rem; opacity: 0.9;">
                    A municipal grievance system built for accountability. Report public infrastructure issues, track verified department workflows with unique IDs, and review claimed resolutions before cases close.
                </p>

                <div class="d-flex flex-wrap gap-3">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Citizen"))
                        {
                            <a asp-controller="Citizen" asp-action="Index" class="btn btn-teal btn-lg px-4 shadow-sm text-white fw-semibold">
                                <i class="bi bi-plus-circle me-1"></i> Go to Citizen Portal
                            </a>
                        }
                        else
                        {
                            <a href="#departments" class="btn btn-teal btn-lg px-4 shadow-sm text-white fw-semibold">
                                <i class="bi bi-grid me-1"></i> View Departments
                            </a>
                        }
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-teal btn-lg px-4 shadow-sm text-white fw-semibold">
                            <i class="bi bi-pencil-square me-1"></i> Submit a Complaint
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg px-4">
                            <i class="bi bi-person me-1"></i> Staff Sign In
                        </a>
                    }
                    <a href="#track-section" class="btn btn-outline-light btn-lg px-3">
                        <i class="bi bi-search me-1"></i> Track Case
                    </a>
                </div>
            </div>

            <!-- Quick Public Lookup Card -->
            <div class="col-lg-5" id="track-section">
                <div class="card shadow-lg border-0 p-3" style="background-color: var(--gd-surface); border-radius: var(--gd-radius-lg);">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge" style="background-color: var(--gd-teal); color: #fff;">Public Lookup</span>
                            <small class="text-muted">Privacy-safe case inquiry</small>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Track Any Complaint</h5>
                        <p class="text-muted small mb-3">
                            Enter the public tracking ID (e.g. <code>GD-7K4P-9X2M</code>) provided upon complaint submission to check its current status.
                        </p>

                        <form asp-controller="Home" asp-action="Track" method="get" class="mb-3">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input type="text" name="id" class="form-control border-start-0" placeholder="e.g. GD-7K4P-9X2M" value="GD-7K4P-9X2M" aria-label="Complaint ID" style="text-transform: uppercase;">
                                <button class="btn btn-primary px-3" type="submit">
                                    Track Status
                                </button>
                            </div>
                        </form>

                        <div class="d-flex align-items-center justify-content-between p-2 rounded bg-light border small text-muted">
                            <span><i class="bi bi-lock me-1 text-success"></i> Privacy Protected</span>
                            <span>No citizen contact info exposed</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     LIVE SYSTEM HEALTH & STANDARDS METRICS
     ========================================================================== -->
<section class="py-3 bg-white border-bottom shadow-xs">
    <div class="container">
        <div class="row g-3 text-center text-md-start align-items-center">
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-3 justify-content-center justify-content-md-start">
                    <div class="p-2 rounded-circle" style="background-color: var(--gd-info-bg);">
                        <i class="bi bi-database-check fs-4 text-info"></i>
                    </div>
                    <div>
                        <div class="small text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Database Connectivity</div>
                        <div class="fw-bold text-dark">
                            @if (ViewBag.DbStatus == "Connected")
                            {
                                <span class="text-success"><i class="bi bi-circle-fill" style="font-size: 0.6rem;"></i> MongoDB Online</span>
                            }
                            else
                            {
                                <span class="text-danger"><i class="bi bi-circle-fill" style="font-size: 0.6rem;"></i> @ViewBag.DbStatus</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-3 justify-content-center justify-content-md-start">
                    <div class="p-2 rounded-circle" style="background-color: var(--gd-success-bg);">
                        <i class="bi bi-clock-history fs-4 text-success"></i>
                    </div>
                    <div>
                        <div class="small text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Review Window</div>
                        <div class="fw-bold text-dark">7-Day Citizen Confirmation</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-3 justify-content-center justify-content-md-start">
                    <div class="p-2 rounded-circle" style="background-color: var(--gd-warning-bg);">
                        <i class="bi bi-card-checklist fs-4 text-warning"></i>
                    </div>
                    <div>
                        <div class="small text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Resolution Standard</div>
                        <div class="fw-bold text-dark">Mandatory Fix Evidence</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-3 justify-content-center justify-content-md-start">
                    <div class="p-2 rounded-circle" style="background-color: var(--gd-surface-muted);">
                        <i class="bi bi-diagram-3 fs-4" style="color: var(--gd-navy);"></i>
                    </div>
                    <div>
                        <div class="small text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Triage Mechanism</div>
                        <div class="fw-bold text-dark">DSA Priority Queue & Heap</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     HOW IT WORKS — 4-STEP TRANSPARENCY PIPELINE
     ========================================================================== -->
<section class="py-5" style="background-color: var(--gd-bg);">
    <div class="container py-2">
        <div class="text-center mb-5">
            <span class="badge badge-teal mb-2">Traceable Lifecycle</span>
            <h2 class="fw-bold text-dark mb-2">How Glass Desk Resolves Public Complaints</h2>
            <p class="text-muted mx-auto" style="max-width: 620px;">
                Every action is timestamped, attributed, and verified. No complaint is closed without proof and citizen review.
            </p>
        </div>

        <div class="row g-4">
            <!-- Step 1 -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm p-4 text-center">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 56px; height: 56px; background-color: var(--gd-info-bg); color: var(--gd-navy);">
                        <span class="fw-bold fs-5">1</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Citizen Submission</h5>
                    <p class="text-muted small mb-0">
                        Citizen submits complaint with approximate area and optional photo. Receives a randomized tracking ID.
                    </p>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm p-4 text-center">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 56px; height: 56px; background-color: var(--gd-warning-bg); color: var(--gd-warning);">
                        <span class="fw-bold fs-5">2</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Verification & Triage</h5>
                    <p class="text-muted small mb-0">
                        Verification Officer assigns official priority with justification, checks duplicate candidates, and routes to department.
                    </p>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm p-4 text-center">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 56px; height: 56px; background-color: rgba(13, 148, 136, 0.15); color: var(--gd-teal);">
                        <span class="fw-bold fs-5">3</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Work & Evidence</h5>
                    <p class="text-muted small mb-0">
                        Department Officer acknowledges, updates progress, and uploads verifiable photo evidence of the completed repair.
                    </p>
                </div>
            </div>

            <!-- Step 4 -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm p-4 text-center">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 56px; height: 56px; background-color: var(--gd-success-bg); color: var(--gd-success);">
                        <span class="fw-bold fs-5">4</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Citizen Review</h5>
                    <p class="text-muted small mb-0">
                        Citizen has 7 days to confirm or dispute. If disputed, case escalates directly to the Department Supervisor.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     MUNICIPAL SERVICE DEPARTMENTS
     ========================================================================== -->
<section class="py-5 bg-white border-top border-bottom" id="departments">
    <div class="container py-2">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4">
            <div>
                <span class="badge badge-navy mb-2">Municipal Directory</span>
                <h2 class="fw-bold text-dark mb-1">Active Service Departments</h2>
                <p class="text-muted mb-0 small">The 5 municipal authorities connected to Glass Desk for workflow processing.</p>
            </div>
            <div class="mt-3 mt-md-0">
                <span class="badge bg-light text-dark border px-3 py-2">All Departments Online</span>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="card h-100 shadow-xs border card-interactive p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded" style="background-color: #e0f2fe; color: #0284c7;">
                            <i class="bi bi-droplet-half fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-1">Water and Sanitation</h6>
                            <p class="text-muted small mb-0">Water supply lines, sewage leaks, garbage collection, and contamination.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-xs border card-interactive p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded" style="background-color: #fef3c7; color: #b45309;">
                            <i class="bi bi-cone-striped fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-1">Transport and Road Services</h6>
                            <p class="text-muted small mb-0">Potholes, broken signals, street paving, road hazards, and pedestrian walkways.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-xs border card-interactive p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded" style="background-color: #f1f5f9; color: var(--gd-navy);">
                            <i class="bi bi-buildings fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-1">Municipal Services</h6>
                            <p class="text-muted small mb-0">Street lighting, public park maintenance, encroachment, and civic facilities.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100 shadow-xs border card-interactive p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded" style="background-color: #dcfce7; color: #15803d;">
                            <i class="bi bi-hospital fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-1">Public Health-Service Administration</h6>
                            <p class="text-muted small mb-0">Sanitary inspections, community vector control, and public health standards.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100 shadow-xs border card-interactive p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded" style="background-color: #f3e8ff; color: #7e22ce;">
                            <i class="bi bi-mortarboard fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-1">Public Education-Service Administration</h6>
                            <p class="text-muted small mb-0">Municipal school facility maintenance, safety hazards, and utility repairs.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     TRANSPARENCY & CITIZEN PRIVACY SAFEGUARDS
     ========================================================================== -->
<section class="py-5" style="background-color: var(--gd-bg);">
    <div class="container py-2">
        <div class="card border-0 shadow-sm p-4 p-md-5" style="border-radius: var(--gd-radius-lg); background: linear-gradient(135deg, #ffffff 0%, var(--gd-surface-muted) 100%);">
            <div class="row align-items-center gy-4">
                <div class="col-lg-8">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge badge-navy">Privacy-First Architecture</span>
                        <small class="text-muted">Security by Design (Discussion 4 & 20)</small>
                    </div>
                    <h3 class="fw-bold text-dark mb-3">Transparency Without Compromising Citizen Privacy</h3>
                    <p class="text-muted mb-3">
                        Glass Desk records public complaint actions and timestamps for civic accountability, but strict safeguards protect your identity:
                    </p>
                    <div class="row g-2 small text-muted">
                        <div class="col-md-6">
                            <div><i class="bi bi-check-circle-fill text-success me-2"></i>Citizen names and phones are never shown publicly</div>
                        </div>
                        <div class="col-md-6">
                            <div><i class="bi bi-check-circle-fill text-success me-2"></i>Exact home addresses are masked to approximate areas</div>
                        </div>
                        <div class="col-md-6">
                            <div><i class="bi bi-check-circle-fill text-success me-2"></i>Internal staff remarks remain strictly protected</div>
                        </div>
                        <div class="col-md-6">
                            <div><i class="bi bi-check-circle-fill text-success me-2"></i>Randomized public tracking IDs prevent case enumeration</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 text-center">
                    <div class="p-4 rounded-circle d-inline-flex align-items-center justify-content-center border shadow-xs" style="width: 120px; height: 120px; background-color: #ffffff;">
                        <i class="bi bi-shield-lock-fill display-4 text-primary" style="color: var(--gd-navy) !important;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>