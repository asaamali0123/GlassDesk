@{
    ViewData["Title"] = "Verification & Triage Portal - Glass Desk";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h2 class="fw-bold mb-0 text-dark">Verification & Triage Console</h2>
                <span class="badge bg-info text-dark px-2 py-1 fs-7">Role: Verification Officer</span>
            </div>
            <p class="text-muted mb-0 small">Officer: <strong>@User.Identity?.Name</strong> | Central Intake & Priority Assignment</p>
        </div>
        <div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
                Central Triage Queue
            </span>
        </div>
    </div>

    <!-- Triage Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-start border-4 border-warning p-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Awaiting Initial Verification</div>
                <div class="h2 fw-bold text-warning mb-0">0</div>
                <div class="text-muted small mt-2">Incoming unverified cases</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-start border-4 border-danger p-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Critical Priority Flags</div>
                <div class="h2 fw-bold text-danger mb-0">0</div>
                <div class="text-muted small mt-2">Immediate emergency safety review</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-start border-4 border-primary p-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Duplicate Matches (DSA)</div>
                <div class="h2 fw-bold text-primary mb-0">0</div>
                <div class="text-muted small mt-2">Similarity match candidates</div>
            </div>
        </div>
    </div>

    <!-- Verification Queue Placeholder -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 fw-semibold border-bottom d-flex justify-content-between align-items-center">
            <span>Incoming Complaints Awaiting Priority & Department Routing</span>
            <span class="badge bg-light text-dark border">DSA Heap Ordering</span>
        </div>
        <div class="card-body text-center py-5 text-muted">
            <div class="display-6 text-muted mb-3">📋</div>
            <h5 class="fw-semibold text-dark">Triage Queue is Clear</h5>
            <p class="small text-muted mb-3">
                Citizen submissions are processed through the triage queue for category validation, priority assignment, and duplicate checks.
            </p>
            <a asp-action="Triage" class="btn btn-teal text-white shadow-sm px-4">
                <i class="bi bi-funnel me-1"></i> Open Triage & Priority Console
            </a>
        </div>
    </div>
</div>