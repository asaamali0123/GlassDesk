@{
    ViewData["Title"] = "Access Denied - Glass Desk";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4">
                <div class="card-body">
                    <div class="display-1 text-danger mb-3">
                        <i class="bi bi-shield-lock"></i> 403
                    </div>
                    <h2 class="fw-bold mb-3">Access Denied</h2>
                    <p class="text-muted mb-4">
                        You do not have the required permissions or role privileges to access this area.
                    </p>
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Go to Home</a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Switch Account / Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>