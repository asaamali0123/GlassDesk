@using GlassDesk.Models
@{
    ViewData["Title"] = "403 Restricted Workspace — Glass Desk";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <!-- Access Denied Card -->
            <div class="card shadow-md border p-4 p-md-5" style="background-color: var(--gd-bg-card); border-color: var(--gd-border); border-radius: var(--gd-radius-lg);">
                <div class="card-body">
                    <!-- Icon -->
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 72px; height: 72px; background-color: var(--gd-critical-bg); border: 1px solid rgba(248, 113, 113, 0.3);">
                        <i class="bi bi-shield-x fs-1" style="color: var(--gd-critical);"></i>
                    </div>

                    <div class="badge bg-danger mb-2" style="font-size: 0.72rem; letter-spacing: 0.05em;">HTTP 403 Forbidden</div>
                    <h3 class="fw-bold text-white mb-2" style="letter-spacing: -0.02em;">Restricted Workspace</h3>

                    <p class="small mb-4" style="color: var(--gd-text-secondary); line-height: 1.6;">
                        You do not possess the verified role privileges required to access this console. In accordance with municipal security governance (Discussion 19), access is strictly restricted by authenticated roles.
                    </p>

                    <!-- Contextual Return Options -->
                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2 mb-4">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole(UserRoles.Citizen))
                            {
                                <a asp-controller="Citizen" asp-action="Index" class="btn btn-teal text-dark fw-semibold px-4">
                                    <i class="bi bi-arrow-left me-1"></i> Return to Citizen Portal
                                </a>
                            }
                            else if (User.IsInRole(UserRoles.VerificationOfficer))
                            {
                                <a asp-controller="VerificationOfficer" asp-action="Index" class="btn btn-teal text-dark fw-semibold px-4">
                                    <i class="bi bi-arrow-left me-1"></i> Return to Triage Console
                                </a>
                            }
                            else if (User.IsInRole(UserRoles.DepartmentOfficer))
                            {
                                <a asp-controller="DepartmentOfficer" asp-action="Index" class="btn btn-teal text-dark fw-semibold px-4">
                                    <i class="bi bi-arrow-left me-1"></i> Return to Department Queue
                                </a>
                            }
                            else if (User.IsInRole(UserRoles.Supervisor))
                            {
                                <a asp-controller="Supervisor" asp-action="Index" class="btn btn-teal text-dark fw-semibold px-4">
                                    <i class="bi bi-arrow-left me-1"></i> Return to Supervisor Console
                                </a>
                            }
                            else if (User.IsInRole(UserRoles.Administrator))
                            {
                                <a asp-controller="Admin" asp-action="Index" class="btn btn-teal text-dark fw-semibold px-4">
                                    <i class="bi bi-arrow-left me-1"></i> Return to Admin Console
                                </a>
                            }
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="Index" class="btn btn-teal text-dark fw-semibold px-4">
                                <i class="bi bi-house me-1"></i> Go to Public Portal
                            </a>
                        }

                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-3">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Switch Account
                        </a>
                    </div>

                    <div class="pt-3 border-top small" style="border-color: var(--gd-border) !important; color: var(--gd-text-muted); font-size: 0.78rem;">
                        <i class="bi bi-lock me-1" style="color: var(--gd-teal);"></i>
                        Glass Desk Server-Side Role Enforcement Active
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>