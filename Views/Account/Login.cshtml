@model GlassDesk.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In — Glass Desk";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <!-- Sign-In Card -->
            <div class="card shadow-md border" style="background-color: var(--gd-bg-card); border-color: var(--gd-border); border-radius: var(--gd-radius-lg);">
                <!-- Card Header -->
                <div class="card-header text-center py-4" style="background-color: var(--gd-bg-secondary); border-bottom: 1px solid var(--gd-border);">
                    <!-- Brand Mark -->
                    <div class="d-inline-flex align-items-center justify-content-center rounded mb-2" style="width: 44px; height: 44px; background: linear-gradient(135deg, rgba(45, 212, 191, 0.2) 0%, rgba(165, 180, 252, 0.1) 100%); border: 1px solid rgba(45, 212, 191, 0.4);">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="3" y="3" width="18" height="18" rx="3" stroke="#2DD4BF" stroke-width="2" stroke-opacity="0.9" />
                            <path d="M3 13L21 13" stroke="#2DD4BF" stroke-width="1.5" stroke-dasharray="2 2" />
                            <path d="M13 3L13 21" stroke="#2DD4BF" stroke-width="1.5" stroke-dasharray="2 2" />
                            <circle cx="13" cy="13" r="3" fill="#2DD4BF" />
                        </svg>
                    </div>
                    <h4 class="fw-bold text-white mb-0" style="letter-spacing: -0.02em;">Sign In to Glass Desk</h4>
                    <span class="small" style="color: var(--gd-text-secondary); font-size: 0.8rem;">Every Concern. Clear Progress.</span>
                </div>

                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center mb-3 small" role="alert">
                            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                            <div>@TempData["SuccessMessage"]</div>
                        </div>
                    }

                    <form asp-action="Login" method="post" id="loginForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 small" role="alert"></div>

                        <!-- Email Address -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-envelope" style="color: var(--gd-teal);"></i>
                                </span>
                                <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="email" autofocus required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Password with Show/Hide Toggle -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <label asp-for="Password" class="form-label">Password</label>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock" style="color: var(--gd-teal);"></i>
                                </span>
                                <input asp-for="Password" id="passwordInput" class="form-control border-end-0" type="password" placeholder="••••••••••••" autocomplete="current-password" required />
                                <button class="btn btn-outline-secondary border-start-0" type="button" id="togglePasswordBtn" title="Toggle password visibility" style="background-color: var(--gd-bg-secondary) !important;">
                                    <i class="bi bi-eye" id="togglePasswordIcon" style="color: var(--gd-text-secondary);"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Optional Specific Portal Target (Section 5) -->
                        <div class="mb-3">
                            <label asp-for="SelectedRole" class="form-label d-flex justify-content-between align-items-center">
                                <span>Target Workspace Portal</span>
                                <span class="badge badge-teal py-0" style="font-size: 0.65rem;">Auto-Detected</span>
                            </label>
                            <select asp-for="SelectedRole" class="form-select">
                                <option value="">Auto-Detect Portal from Credentials</option>
                                <option value="Citizen">Citizen Portal</option>
                                <option value="VerificationOfficer">Verification Officer Console</option>
                                <option value="DepartmentOfficer">Department Officer Work Queue</option>
                                <option value="Supervisor">Supervisor Oversight Console</option>
                                <option value="Administrator">Administrator Console</option>
                            </select>
                            <span class="small d-block mt-1" style="color: var(--gd-text-muted); font-size: 0.74rem;">
                                Leave as Auto-Detect, or explicitly select a role to test server authorization.
                            </span>
                        </div>

                        <!-- Remember Me -->
                        <div class="form-check mb-4">
                            <input class="form-check-input" asp-for="RememberMe" id="rememberMeCheck" />
                            <label class="form-check-label small" for="rememberMeCheck">
                                Keep me signed in on this browser
                            </label>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-teal w-100 text-dark fw-semibold py-2 mb-3 shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Workspace
                        </button>

                        <!-- Citizen Sign-Up Prompt -->
                        <div class="text-center pt-3 border-top small" style="border-color: var(--gd-border) !important;">
                            <span style="color: var(--gd-text-secondary);">New citizen reporting an issue? </span>
                            <a asp-action="Register" class="fw-semibold text-decoration-none" style="color: var(--gd-teal);">Create Citizen Account</a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Demo Credentials Reference Drawer (Discussion 17) -->
            <div class="card mt-4 border shadow-xs" style="background-color: var(--gd-bg-card); border-color: var(--gd-border);">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-bold small text-white"><i class="bi bi-key text-teal me-1"></i> Pre-Seeded Evaluation Accounts</span>
                        <span class="badge" style="background-color: var(--gd-bg-secondary); border: 1px solid var(--gd-border); color: var(--gd-text-secondary); font-size: 0.68rem;">
                            Password: <code class="text-teal">GlassDesk#2026</code>
                        </span>
                    </div>
                    <ul class="list-unstyled mb-0 small" style="color: var(--gd-text-secondary); font-size: 0.76rem; line-height: 1.6;">
                        <li><strong>Citizen:</strong> <code>citizen@glassdesk.local</code></li>
                        <li><strong>Verification Officer:</strong> <code>verifier@glassdesk.local</code></li>
                        <li><strong>Department Officer:</strong> <code>officer.water@glassdesk.local</code></li>
                        <li><strong>Supervisor:</strong> <code>supervisor.water@glassdesk.local</code></li>
                        <li><strong>Administrator:</strong> <code>admin@glassdesk.local</code></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Password Visibility Toggle
        document.getElementById('togglePasswordBtn').addEventListener('click', function () {
            var passwordInput = document.getElementById('passwordInput');
            var icon = document.getElementById('togglePasswordIcon');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        });
    </script>
}