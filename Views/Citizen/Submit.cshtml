@{
    ViewData["Title"] = "Submit New Complaint — Glass Desk";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Citizen Workspace</a></li>
            <li class="breadcrumb-item active" aria-current="page">Submit Service Complaint</li>
        </ol>
    </nav>

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom" style="border-color: var(--gd-border) !important;">
        <div>
            <h2 class="fw-bold mb-0 text-white" style="letter-spacing: -0.02em;">Submit a Service Complaint</h2>
            <p class="small mb-0" style="color: var(--gd-text-secondary);">
                Report a municipal breakdown for official triage, department dispatch, and verified resolution.
            </p>
        </div>
        <div>
            <span class="badge bg-warning text-dark px-3 py-2 fw-semibold">
                <i class="bi bi-gear-wide me-1"></i> Form Preview (In Progress)
            </span>
        </div>
    </div>

    <!-- Prototype State Notice -->
    <div class="alert alert-info d-flex align-items-center shadow-xs border-0 mb-4" role="alert" style="background-color: var(--gd-info-bg); border: 1px solid rgba(96, 165, 250, 0.25);">
        <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
        <div>
            <strong class="d-block text-white small">Interactive Prototype View Active</strong>
            <span class="small" style="color: var(--gd-text-secondary);">
                This form presents all civic reporting fields specified in Discussions 4 & 21. Real database insertion, secure file storage, and randomized public ID generation (<code>GD-XXXX-XXXX</code>) connect in the functional workflow milestone.
            </span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Form Column -->
        <div class="col-lg-8">
            <div class="card shadow-sm border p-4" style="background-color: var(--gd-bg-card); border-color: var(--gd-border); border-radius: var(--gd-radius-md);">
                <form>
                    <!-- Category Selection -->
                    <div class="mb-3">
                        <label class="form-label">Municipal Category <span class="text-danger">*</span></label>
                        <select class="form-select" required>
                            <option value="" selected>Select affected municipal department...</option>
                            <option value="Water">Water and Sanitation (Supply line burst, contaminated water, sewage overflow)</option>
                            <option value="Roads">Transport & Road Services (Potholes, broken signals, pavement erosion)</option>
                            <option value="Municipal">Municipal Services (Streetlight outages, public park damage)</option>
                            <option value="Health">Public Health (Garbage dumps, sanitary hazards, standing water)</option>
                            <option value="Education">Public Education (Municipal school facility repairs, safety hazards)</option>
                        </select>
                        <div class="small mt-1" style="color: var(--gd-text-muted); font-size: 0.76rem;">Predefined municipal divisions ensure direct routing to authorized field staff.</div>
                    </div>

                    <!-- Complaint Title -->
                    <div class="mb-3">
                        <label class="form-label">Complaint Title / Summary <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" placeholder="e.g. Ruptured clean water pipeline flooding street" required />
                    </div>

                    <!-- Approximate Location -->
                    <div class="mb-3">
                        <label class="form-label">Approximate Area / Neighborhood <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-geo-alt" style="color: var(--gd-teal);"></i>
                            </span>
                            <input type="text" class="form-control" placeholder="e.g. Sector G-9/2, Near Commercial Market" required />
                        </div>
                        <div class="d-flex align-items-center gap-1 mt-1 small" style="color: var(--gd-text-muted); font-size: 0.74rem;">
                            <i class="bi bi-shield-check" style="color: var(--gd-success);"></i>
                            <span>Privacy Safeguard: Give a neighborhood or landmark. Exact residential addresses are masked on public inquiry pages.</span>
                        </div>
                    </div>

                    <!-- Perceived Urgency -->
                    <div class="mb-3">
                        <label class="form-label">Perceived Community Impact & Urgency</label>
                        <div class="d-flex flex-wrap gap-3 p-3 rounded border" style="background-color: var(--gd-bg-secondary); border-color: var(--gd-border) !important;">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="urgency" id="urgencyLow" value="Low">
                                <label class="form-check-label small" for="urgencyLow">Low (Minor inconvenience)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="urgency" id="urgencyMed" value="Medium" checked>
                                <label class="form-check-label small" for="urgencyMed">Medium (Impacting local neighborhood)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="urgency" id="urgencyHigh" value="High">
                                <label class="form-check-label small" for="urgencyHigh">High (Immediate disruption / safety risk)</label>
                            </div>
                        </div>
                    </div>

                    <!-- Detailed Description -->
                    <div class="mb-3">
                        <label class="form-label">Detailed Description <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="4" placeholder="Detail the issue, approximately when it started, and specific hazards observed..." required></textarea>
                    </div>

                    <!-- File Evidence Upload -->
                    <div class="mb-4">
                        <label class="form-label">Supporting Evidence / Photos (Optional)</label>
                        <input class="form-control" type="file" accept=".jpg,.jpeg,.png,.pdf" />
                        <div class="small mt-1" style="color: var(--gd-text-muted); font-size: 0.76rem;">
                            Supports JPG, PNG, or PDF up to 5MB. Files are verified and stored outside the public web root (Discussion 29).
                        </div>
                    </div>

                    <!-- Action Controls -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top" style="border-color: var(--gd-border) !important;">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to Workspace
                        </a>
                        <button type="button" class="btn btn-teal text-dark fw-semibold px-4 shadow-sm" disabled>
                            <i class="bi bi-send me-1"></i> Submit Complaint (Backend Step)
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Sidebar Guidelines -->
        <div class="col-lg-4">
            <!-- Process Overview -->
            <div class="card p-3 border mb-3 shadow-xs" style="background-color: var(--gd-bg-card); border-color: var(--gd-border);">
                <h6 class="fw-bold text-white mb-2 d-flex align-items-center gap-1">
                    <i class="bi bi-diagram-3" style="color: var(--gd-teal);"></i> What happens after submission?
                </h6>
                <ol class="small ps-3 mb-0" style="color: var(--gd-text-secondary); line-height: 1.6; font-size: 0.78rem;">
                    <li class="mb-2">A randomized public tracking ID (e.g. <code>GD-7K4P-9X2M</code>) is issued immediately.</li>
                    <li class="mb-2">A Central Verification Officer reviews the report, assigns official priority, and routes the work order.</li>
                    <li class="mb-2">The assigned department inspects and resolves the issue, providing mandatory photographic proof.</li>
                    <li>You receive a 7-day review window to inspect the repair evidence and confirm resolution or lodge a dispute.</li>
                </ol>
            </div>

            <!-- Emergency Disclaimer Notice (Discussion 30) -->
            <div class="card p-3 border shadow-xs" style="background-color: var(--gd-bg-card); border-left: 4px solid var(--gd-warning) !important; border-color: var(--gd-border);">
                <div class="small" style="color: var(--gd-text-secondary); font-size: 0.78rem; line-height: 1.5;">
                    <strong class="text-white d-block mb-1">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> Not an Emergency Service
                    </strong>
                    Glass Desk manages municipal maintenance workflows. For active fires, gas leaks, crimes, or acute medical emergencies, contact local emergency services immediately.
                </div>
            </div>
        </div>
    </div>
</div>