@{
    ViewData["Title"] = "Submit New Complaint - Glass Desk";
}

<div class="container py-4">
    <!-- Breadcrumb & Navigation -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Citizen Portal</a></li>
            <li class="breadcrumb-item active" aria-current="page">Submit Complaint</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-0 text-dark">Submit a Service Complaint</h2>
            <p class="text-muted mb-0 small">Report a municipal issue for department triage and traceable resolution.</p>
        </div>
        <div>
            <span class="badge bg-warning text-dark px-3 py-2">
                <i class="bi bi-gear-wide me-1"></i> Form Preview (In Progress)
            </span>
        </div>
    </div>

    <!-- Prototype In-Progress Notice -->
    <div class="alert alert-info d-flex align-items-center shadow-xs border-0 mb-4" role="alert">
        <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
        <div>
            <strong class="d-block">UI Prototype View Active</strong>
            <span class="small">
                This form captures all civic fields required by Discussion 4 & 21. Full database submission and randomized public ID generation (<code>GD-XXXX-XXXX</code>) are configured for the backend data phase.
            </span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Form Column -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 p-4">
                <form>
                    <!-- Category Selection -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Municipal Category <span class="text-danger">*</span></label>
                        <select class="form-select">
                            <option selected>-- Select Affected Municipal Service --</option>
                            <option value="Water">Water and Sanitation (Supply line, leak, sewage)</option>
                            <option value="Roads">Transport & Road Services (Potholes, broken signals)</option>
                            <option value="Municipal">Municipal Services (Streetlights, park maintenance)</option>
                            <option value="Health">Public Health (Sanitary hazards, waste dump)</option>
                            <option value="Education">Public Education (Municipal school facilities)</option>
                        </select>
                        <div class="form-text small">Categories are predefined by municipal administration (Discussion 4).</div>
                    </div>

                    <!-- Complaint Title -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Complaint Summary / Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" placeholder="e.g. Major water pipe burst leaking onto main road" />
                    </div>

                    <!-- Approximate Location -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Approximate Area / Location <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" placeholder="e.g. Sector G-9/2, Near Commercial Market" />
                        <div class="form-text small text-muted">
                            <i class="bi bi-shield-check text-success me-1"></i>
                            <strong>Privacy rule:</strong> Provide a neighborhood or landmark. Precise private home addresses are never exposed publicly.
                        </div>
                    </div>

                    <!-- Citizen-Reported Urgency -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Perceived Urgency & Community Impact</label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="urgency" id="urgencyLow" value="Low">
                                <label class="form-check-label" for="urgencyLow">Low (Minor inconvenience)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="urgency" id="urgencyMed" value="Medium" checked>
                                <label class="form-check-label" for="urgencyMed">Medium (Impacting neighborhood)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="urgency" id="urgencyHigh" value="High">
                                <label class="form-check-label" for="urgencyHigh">High (Safety risk / disruption)</label>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Detailed Description <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="4" placeholder="Describe the issue, how long it has persisted, and any specific hazards..."></textarea>
                    </div>

                    <!-- File Evidence Upload -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Supporting Photo Evidence (Optional)</label>
                        <input class="form-control" type="file" accept=".jpg,.jpeg,.png,.pdf" />
                        <div class="form-text small">Accepts JPG, PNG, or PDF up to 5MB. Stored securely outside public webroot (Discussion 29).</div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                        </a>
                        <button type="button" class="btn btn-teal text-white px-4 fw-semibold shadow-sm" disabled>
                            <i class="bi bi-send me-1"></i> Submit Complaint (Backend Step)
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Sidebar Guidelines -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-3 bg-light">
                <div class="card-body">
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-shield-check text-primary me-1"></i> What happens next?</h6>
                    <ol class="small text-muted ps-3 mb-0">
                        <li class="mb-2">You receive a random public tracking ID (e.g. <code>GD-7K4P-9X2M</code>).</li>
                        <li class="mb-2">A Verification Officer checks details, confirms official priority, and assigns the municipal department.</li>
                        <li class="mb-2">The assigned department inspects and resolves the issue.</li>
                        <li>You get 7 days to review and confirm or dispute the resolution.</li>
                    </ol>
                </div>
            </div>

            <div class="card shadow-sm border-0 border-start border-4 border-warning p-3">
                <div class="small text-muted">
                    <strong class="text-dark d-block mb-1"><i class="bi bi-exclamation-triangle text-warning me-1"></i> Not an Emergency System</strong>
                    For live fires, crime, or medical emergencies, contact local emergency response numbers immediately.
                </div>
            </div>
        </div>
    </div>
</div>