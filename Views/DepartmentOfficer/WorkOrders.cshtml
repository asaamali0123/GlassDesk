@{
    ViewData["Title"] = "Work Orders & Resolution Evidence — Glass Desk";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Department Operations</a></li>
            <li class="breadcrumb-item active" aria-current="page">Work Orders & Resolution Console</li>
        </ol>
    </nav>

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom" style="border-color: var(--gd-border) !important;">
        <div>
            <h2 class="fw-bold mb-0 text-white" style="letter-spacing: -0.02em;">Active Work Orders & Resolution Console</h2>
            <p class="small mb-0" style="color: var(--gd-text-secondary);">
                Acknowledge assignments, post field progress milestones, upload fix evidence, or execute documented department transfers.
            </p>
        </div>
        <div>
            <span class="badge bg-warning text-dark px-3 py-2 fw-semibold">
                <i class="bi bi-gear-wide me-1"></i> Operations View (In Progress)
            </span>
        </div>
    </div>

    <!-- Prototype State Notice -->
    <div class="alert alert-info d-flex align-items-center shadow-xs border-0 mb-4" role="alert" style="background-color: var(--gd-info-bg); border: 1px solid rgba(96, 165, 250, 0.25);">
        <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
        <div>
            <strong class="d-block text-white small">Interactive Field Operations Mock Active</strong>
            <span class="small" style="color: var(--gd-text-secondary);">
                This console demonstrates Discussions 4, 5, & 24. Live resolution photo storage, transfer history logging, and the 7-day citizen review clock connect during the workflow logic milestone.
            </span>
        </div>
    </div>

    <!-- Active Work Order Card -->
    <div class="card shadow-sm border mb-4" style="background-color: var(--gd-bg-card); border-color: var(--gd-border); border-radius: var(--gd-radius-md);">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2" style="background-color: var(--gd-bg-secondary); border-bottom: 1px solid var(--gd-border);">
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-teal">Water and Sanitation</span>
                <span class="small" style="color: var(--gd-text-muted);">Work Order ID:</span>
                <span class="font-monospace fw-bold" style="color: var(--gd-teal);">GD-7K4P-9X2M</span>
            </div>
            <div class="d-flex gap-2">
                <span class="badge" style="background-color: var(--gd-warning-bg); color: var(--gd-warning); border: 1px solid rgba(251, 191, 36, 0.3);">
                    Status: InProgress
                </span>
                <span class="badge bg-danger">Priority: High</span>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">
                <!-- Case Summary & Timeline Column -->
                <div class="col-lg-7">
                    <h5 class="fw-bold text-white mb-2">Main water supply line ruptured, flooding street</h5>
                    <div class="d-flex flex-wrap gap-3 small mb-3" style="color: var(--gd-text-secondary);">
                        <span><i class="bi bi-geo-alt text-danger me-1"></i> Sector G-9/2, Near Commercial Area</span>
                        <span><i class="bi bi-calendar-event me-1 text-teal"></i> Assigned: Today, 09:30 AM</span>
                    </div>

                    <!-- Citizen Issue Context -->
                    <div class="p-3 rounded border mb-4" style="background-color: var(--gd-bg-secondary); border-color: var(--gd-border) !important;">
                        <div class="small fw-semibold text-white mb-1">Citizen Issue Report:</div>
                        <p class="small mb-0" style="color: var(--gd-text-secondary); line-height: 1.6;">
                            "Clean water has been gushing from the main line since 6:00 AM, flooding adjacent shops and reducing water pressure for residential blocks."
                        </p>
                    </div>

                    <!-- Recorded Progress Milestones (Discussion 43) -->
                    <h6 class="fw-bold text-white mb-2 d-flex align-items-center gap-1">
                        <i class="bi bi-clock-history text-teal me-1"></i> Recorded Action History
                    </h6>
                    <div class="position-relative ps-3 ms-2 mb-3" style="border-left: 2px solid var(--gd-teal); font-size: 0.8rem;">
                        <div class="mb-2">
                            <span style="color: var(--gd-text-muted);">Today 09:45 AM:</span>
                            <strong class="text-white d-block">Assignment Acknowledged</strong>
                            <span style="color: var(--gd-text-secondary);">Officer Usman accepted work order. Separate acknowledgment SLA recorded.</span>
                        </div>
                        <div>
                            <span style="color: var(--gd-text-muted);">Today 11:15 AM:</span>
                            <strong class="text-white d-block">Field Crew Deployed</strong>
                            <span style="color: var(--gd-text-secondary);">Repair team dispatched with excavation unit to isolate damaged 4-inch pipe section.</span>
                        </div>
                    </div>
                </div>

                <!-- Officer Action Controls Column -->
                <div class="col-lg-5">
                    <div class="card p-3 border shadow-xs" style="background-color: var(--gd-bg-secondary); border-color: var(--gd-border);">
                        <h6 class="fw-bold text-white mb-3 d-flex align-items-center gap-1">
                            <i class="bi bi-pencil-square text-teal me-1"></i> Operational Actions
                        </h6>

                        <!-- Action 1: Submit Proposed Resolution -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-white">
                                1. Submit Resolution & Fix Evidence (Discussion 4 & 5)
                            </label>
                            <textarea class="form-control form-control-sm mb-2" rows="2" placeholder="Describe the completed repair details (e.g. Ruptured pipe section replaced and pressure tested)..."></textarea>

                            <label class="form-label small" style="color: var(--gd-text-secondary); font-size: 0.76rem;">
                                Repair Evidence Photo / File <span class="text-danger">*</span>
                            </label>
                            <input class="form-control form-control-sm mb-2" type="file" accept=".jpg,.png,.pdf" />

                            <div class="small mb-2" style="color: var(--gd-text-muted); font-size: 0.72rem;">
                                Mandatory proof: transitions case to <em>Awaiting Citizen Review</em> and starts 7-day clock.
                            </div>

                            <button class="btn btn-teal btn-sm text-dark w-100 fw-semibold" disabled>
                                <i class="bi bi-check2-circle me-1"></i> Submit Resolution for Citizen Review
                            </button>
                        </div>

                        <hr style="border-color: var(--gd-border);" />

                        <!-- Action 2: Transfer Case -->
                        <div>
                            <label class="form-label small fw-semibold text-white">
                                2. Transfer Case to Another Department (Discussion 24)
                            </label>
                            <select class="form-select form-select-sm mb-2">
                                <option>-- Select Department --</option>
                                <option>Transport and Road Services (Pavement repair needed)</option>
                                <option>Municipal Services (Street drainage damaged)</option>
                                <option>Public Health-Service Administration</option>
                                <option>Public Education-Service Administration</option>
                            </select>

                            <input type="text" class="form-control form-control-sm mb-2" placeholder="Mandatory transfer reason (Discussion 24)..." />

                            <button class="btn btn-outline-secondary btn-sm w-100" disabled>
                                <i class="bi bi-arrow-left-right me-1"></i> Record & Transfer Case
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Return Strip -->
            <div class="d-flex justify-content-between align-items-center pt-3 mt-3 border-top" style="border-color: var(--gd-border) !important;">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Queue
                </a>
                <span class="small" style="color: var(--gd-text-muted); font-size: 0.76rem;">
                    <i class="bi bi-shield-check text-teal me-1"></i> Glass Desk Automated SLA & Audit Tracking Active
                </span>
            </div>
        </div>
    </div>
</div>