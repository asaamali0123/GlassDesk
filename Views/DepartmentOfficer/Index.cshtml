@{
    ViewData["Title"] = "Department Operations — Glass Desk";
    var deptName = User.FindFirst("Department")?.Value ?? "Water and Sanitation";
}

<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3" style="border-color: var(--gd-border) !important;">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h2 class="fw-bold mb-0 text-white" style="letter-spacing: -0.02em;">Department Operations Queue</h2>
                <span class="badge badge-teal">Field Dispatch Authority</span>
            </div>
            <p class="small mb-0" style="color: var(--gd-text-secondary);">
                Officer: <strong>@User.Identity?.Name</strong> | Department: <strong class="text-white">@deptName</strong>
            </p>
        </div>
        <div>
            <a asp-action="WorkOrders" class="btn btn-teal text-dark fw-semibold shadow-sm px-4">
                <i class="bi bi-clipboard-check me-1"></i> Manage Active Work Orders
            </a>
        </div>
    </div>

    <!-- Operational Metrics -->
    <div class="row g-3 mb-4">
        <!-- Metric 1: Assigned Work Orders -->
        <div class="col-6 col-lg-3">
            <div class="card h-100 p-3 border shadow-xs" style="background-color: var(--gd-bg-card); border-color: var(--gd-border);">
                <div class="small fw-semibold text-uppercase" style="color: var(--gd-text-muted); font-size: 0.72rem; letter-spacing: 0.04em;">Assigned Orders</div>
                <div class="h2 fw-bold text-white mb-0 mt-1">1</div>
                <div class="small mt-2" style="color: var(--gd-text-secondary); font-size: 0.76rem;">Work orders routed to department</div>
            </div>
        </div>

        <!-- Metric 2: Active in Progress -->
        <div class="col-6 col-lg-3">
            <div class="card h-100 p-3 border shadow-xs" style="background-color: var(--gd-bg-card); border-color: var(--gd-border);">
                <div class="small fw-semibold text-uppercase" style="color: var(--gd-text-muted); font-size: 0.72rem; letter-spacing: 0.04em;">In Progress</div>
                <div class="h2 fw-bold mb-0 mt-1" style="color: var(--gd-warning);">1</div>
                <div class="small mt-2" style="color: var(--gd-text-secondary); font-size: 0.76rem;">Excavation & repair ongoing</div>
            </div>
        </div>

        <!-- Metric 3: Approaching SLA -->
        <div class="col-6 col-lg-3">
            <div class="card h-100 p-3 border shadow-xs" style="background-color: var(--gd-bg-card); border-color: var(--gd-border);">
                <div class="small fw-semibold text-uppercase" style="color: var(--gd-text-muted); font-size: 0.72rem; letter-spacing: 0.04em;">Approaching SLA</div>
                <div class="h2 fw-bold mb-0 mt-1" style="color: var(--gd-teal);">0</div>
                <div class="small mt-2" style="color: var(--gd-text-secondary); font-size: 0.76rem;">All active orders within target</div>
            </div>
        </div>

        <!-- Metric 4: Proposed Resolutions -->
        <div class="col-6 col-lg-3">
            <div class="card h-100 p-3 border shadow-xs" style="background-color: var(--gd-bg-card); border-color: var(--gd-border);">
                <div class="small fw-semibold text-uppercase" style="color: var(--gd-text-muted); font-size: 0.72rem; letter-spacing: 0.04em;">Awaiting Citizen Review</div>
                <div class="h2 fw-bold mb-0 mt-1" style="color: var(--gd-success);">0</div>
                <div class="small mt-2" style="color: var(--gd-text-secondary); font-size: 0.76rem;">7-day citizen confirmation window</div>
            </div>
        </div>
    </div>

    <!-- Active Department Queue Table -->
    <div class="card shadow-sm border" style="background-color: var(--gd-bg-card); border-color: var(--gd-border); border-radius: var(--gd-radius-md);">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2" style="background-color: var(--gd-bg-secondary); border-bottom: 1px solid var(--gd-border);">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-semibold text-white small">
                    <i class="bi bi-tools me-1" style="color: var(--gd-teal);"></i> Department Repair Queue
                </span>
                <span class="badge" style="background-color: var(--gd-bg-card); border: 1px solid var(--gd-border); color: var(--gd-text-secondary); font-size: 0.68rem;">
                    @deptName
                </span>
            </div>
            <span class="badge badge-teal">1 Active Order</span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Work Order ID</th>
                            <th>Issue Summary</th>
                            <th>Area</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Response SLA</th>
                            <th>Assigned</th>
                            <th class="text-end pe-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="ps-3">
                                <span class="font-monospace fw-bold" style="color: var(--gd-teal);">GD-7K4P-9X2M</span>
                            </td>
                            <td>
                                <strong class="text-white d-block">Main water supply line ruptured</strong>
                                <span class="small" style="color: var(--gd-text-secondary);">Excavation and pipe isolation team deployed.</span>
                            </td>
                            <td style="color: var(--gd-text-secondary);">Sector G-9/2</td>
                            <td>
                                <span class="badge bg-danger">High</span>
                            </td>
                            <td>
                                <span class="badge" style="background-color: var(--gd-warning-bg); color: var(--gd-warning); border: 1px solid rgba(251, 191, 36, 0.3);">
                                    InProgress
                                </span>
                            </td>
                            <td>
                                <span class="small" style="color: var(--gd-success);"><i class="bi bi-check-circle me-1"></i> Within Target</span>
                            </td>
                            <td style="color: var(--gd-text-muted);">Today 09:30 AM</td>
                            <td class="text-end pe-3">
                                <a asp-action="WorkOrders" class="btn btn-teal btn-sm text-dark fw-semibold px-3" style="font-size: 0.78rem;">
                                    <i class="bi bi-pencil-square me-1"></i> Update Order
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Footer Governance Note -->
        <div class="card-footer d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 small" style="background-color: var(--gd-bg-secondary); border-top: 1px solid var(--gd-border); font-size: 0.76rem; color: var(--gd-text-muted);">
            <div>
                <i class="bi bi-shield-check me-1" style="color: var(--gd-teal);"></i>
                <strong>Discussions 4 & 5:</strong> Department Officers must attach verifiable resolution photo proof before submitting cases to citizen review.
            </div>
            <div>
                <span class="badge" style="background-color: var(--gd-bg-card); border: 1px solid var(--gd-border); color: var(--gd-text-secondary);">Field Operations Active</span>
            </div>
        </div>
    </div>
</div>