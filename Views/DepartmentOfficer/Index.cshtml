@{
    ViewData["Title"] = "Department Officer - Glass Desk";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-0">Department Operations Portal</h2>
            <p class="text-muted mb-0">Officer: <strong>@User.Identity?.Name</strong> | Dept: <strong>@User.FindFirst("Department")?.Value</strong></p>
        </div>
        <div>
            <span class="badge bg-secondary px-3 py-2 fs-6">Role: Department Officer</span>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 text-center bg-light">
                <h3 class="fw-bold text-primary mb-0">0</h3>
                <small class="text-muted">Assigned Work Orders</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 text-center bg-light">
                <h3 class="fw-bold text-warning mb-0">0</h3>
                <small class="text-muted">In Progress</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 text-center bg-light">
                <h3 class="fw-bold text-danger mb-0">0</h3>
                <small class="text-muted">Approaching Overdue SLA</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 text-center bg-light">
                <h3 class="fw-bold text-success mb-0">0</h3>
                <small class="text-muted">Proposed Resolutions</small>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 fw-semibold">Assigned Department Cases</div>
        <div class="card-body text-center py-5 text-muted">
            <p class="small text-muted mb-3">
                Manage your department's active repair queue, post progress updates, and upload mandatory resolution proof.
            </p>
            <a asp-action="WorkOrders" class="btn btn-teal text-white shadow-sm px-4">
                <i class="bi bi-clipboard-check me-1"></i> Manage Active Work Orders
            </a>
        </div>
    </div>
</div>