@{
    ViewData["Title"] = "Supervisor Portal - Glass Desk";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-0">Supervisor Oversight Portal</h2>
            <p class="text-muted mb-0">Supervisor: <strong>@User.Identity?.Name</strong> | Dept: <strong>@User.FindFirst("Department")?.Value</strong></p>
        </div>
        <div>
            <span class="badge bg-warning text-dark px-3 py-2 fs-6">Role: Supervisor</span>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 text-center border-start border-4 border-danger">
                <h3 class="fw-bold text-danger mb-0">0</h3>
                <small class="text-muted">Overdue Cases (Escalated)</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 text-center border-start border-4 border-warning">
                <h3 class="fw-bold text-warning mb-0">0</h3>
                <small class="text-muted">Citizen Disputes</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 text-center border-start border-4 border-info">
                <h3 class="fw-bold text-info mb-0">0</h3>
                <small class="text-muted">Reopening Requests</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 text-center border-start border-4 border-success">
                <h3 class="fw-bold text-success mb-0">0</h3>
                <small class="text-muted">Department Total Resolved</small>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 fw-semibold">Escalation & Dispute Review Queue</div>
        <div class="card-body text-center py-5 text-muted">
            <p class="small text-muted mb-3">
                Review citizen-disputed resolution claims, adjudicate reopening requests, and inspect SLA overdue breaches.
            </p>
            <a asp-action="Escalations" class="btn btn-teal text-white shadow-sm px-4">
                <i class="bi bi-exclamation-triangle me-1"></i> Open Dispute & Escalation Console
            </a>
        </div>
    </div>
</div>