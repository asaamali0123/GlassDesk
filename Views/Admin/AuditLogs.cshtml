@{
    ViewData["Title"] = "System Audit Logs - Glass Desk";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Admin Console</a></li>
            <li class="breadcrumb-item active" aria-current="page">System Audit Logs</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-0 text-dark">Dedicated System-Wide Audit Log</h2>
            <p class="text-muted mb-0 small">Append-only administrative trail of authentication, security events, and role updates (Discussion 35 & 36).</p>
        </div>
        <div>
            <span class="badge bg-warning text-dark px-3 py-2">
                <i class="bi bi-gear-wide me-1"></i> Audit Viewer (In Progress)
            </span>
        </div>
    </div>

    <!-- Security Guarantee Box -->
    <div class="alert alert-dark d-flex align-items-center shadow-xs border-0 mb-4" role="alert">
        <i class="bi bi-shield-check fs-3 me-3 text-success"></i>
        <div>
            <strong class="d-block text-white">Append-Only Audit Guarantee (Discussion 36)</strong>
            <span class="small text-white-50">
                Audit records cannot be edited or deleted through the application. Passwords and secrets are never logged.
            </span>
        </div>
    </div>

    <!-- Audit Log Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-dark"><i class="bi bi-journal-text text-teal me-1"></i> Recorded Security Events</span>
            <span class="badge bg-light text-dark border">Sample Activity</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Timestamp (UTC)</th>
                            <th>Event Type</th>
                            <th>Actor</th>
                            <th>Affected Resource</th>
                            <th>Outcome</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="ps-3 text-muted">@DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge bg-primary">UserLoginSuccess</span></td>
                            <td><strong>admin@glassdesk.local</strong></td>
                            <td>Session Authorization Cookie</td>
                            <td><span class="badge bg-success">Success</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 text-muted">@DateTime.UtcNow.AddMinutes(-12).ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge bg-secondary">SystemDatabasePing</span></td>
                            <td><strong>System Startup</strong></td>
                            <td>MongoDB (glassdeskdb)</td>
                            <td><span class="badge bg-success">Online</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 text-muted">@DateTime.UtcNow.AddMinutes(-30).ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge bg-dark">DatabaseSeederExecuted</span></td>
                            <td><strong>Startup Lifecycle</strong></td>
                            <td>users collection (5 seeded accounts)</td>
                            <td><span class="badge bg-success">Complete</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 text-muted">@DateTime.UtcNow.AddHours(-1).ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge bg-warning text-dark">AccessControlCheck</span></td>
                            <td><strong>Anonymous Visitor</strong></td>
                            <td>/Admin Portal Request</td>
                            <td><span class="badge bg-danger">Denied (403)</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white border-top py-3 text-end">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Admin Console
            </a>
        </div>
    </div>
</div>