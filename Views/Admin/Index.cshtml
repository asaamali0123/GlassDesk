@{
    ViewData["Title"] = "System Administration — Glass Desk";
}

<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3" style="border-color: var(--gd-border) !important;">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h2 class="fw-bold mb-0 text-white" style="letter-spacing: -0.02em;">System Administration & Governance</h2>
                <span class="badge badge-teal">System Governance</span>
            </div>
            <p class="small mb-0" style="color: var(--gd-text-secondary);">
                Administrator: <strong>@User.Identity?.Name</strong> | Central Role & Department Directory
            </p>
        </div>
        <div>
            <span class="badge" style="background-color: var(--gd-success-bg); color: var(--gd-success); border: 1px solid rgba(52, 211, 153, 0.3); padding: 0.45rem 0.85rem;">
                <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> System Operational
            </span>
        </div>
    </div>

    <!-- Governance Metrics -->
    <div class="row g-3 mb-4">
        <!-- Metric 1: Staff Accounts -->
        <div class="col-6 col-lg-3">
            <div class="card h-100 p-3 border shadow-xs" style="background-color: var(--gd-bg-card); border-color: var(--gd-border);">
                <div class="small fw-semibold text-uppercase" style="color: var(--gd-text-muted); font-size: 0.72rem; letter-spacing: 0.04em;">Active Staff Accounts</div>
                <div class="h2 fw-bold text-white mb-0 mt-1">5</div>
                <div class="small mt-2" style="color: var(--gd-success); font-size: 0.76rem;"><i class="bi bi-check2 me-1"></i> Seeded & Active</div>
            </div>
        </div>

        <!-- Metric 2: Municipal Departments -->
        <div class="col-6 col-lg-3">
            <div class="card h-100 p-3 border shadow-xs" style="background-color: var(--gd-bg-card); border-color: var(--gd-border);">
                <div class="small fw-semibold text-uppercase" style="color: var(--gd-text-muted); font-size: 0.72rem; letter-spacing: 0.04em;">Municipal Departments</div>
                <div class="h2 fw-bold mb-0 mt-1" style="color: var(--gd-teal);">5</div>
                <div class="small mt-2" style="color: var(--gd-text-secondary); font-size: 0.76rem;">All divisions configured</div>
            </div>
        </div>

        <!-- Metric 3: SLA Review Window -->
        <div class="col-6 col-lg-3">
            <div class="card h-100 p-3 border shadow-xs" style="background-color: var(--gd-bg-card); border-color: var(--gd-border);">
                <div class="small fw-semibold text-uppercase" style="color: var(--gd-text-muted); font-size: 0.72rem; letter-spacing: 0.04em;">Citizen Review SLA</div>
                <div class="h2 fw-bold mb-0 mt-1" style="color: var(--gd-warning);">7 Days</div>
                <div class="small mt-2" style="color: var(--gd-text-secondary); font-size: 0.76rem;">Confirmation window active</div>
            </div>
        </div>

        <!-- Metric 4: Audit Log Pipeline -->
        <div class="col-6 col-lg-3">
            <div class="card h-100 p-3 border shadow-xs" style="background-color: var(--gd-bg-card); border-color: var(--gd-border);">
                <div class="small fw-semibold text-uppercase" style="color: var(--gd-text-muted); font-size: 0.72rem; letter-spacing: 0.04em;">Audit Trail</div>
                <div class="h2 fw-bold mb-0 mt-1" style="color: var(--gd-indigo);">Active</div>
                <div class="small mt-2" style="color: var(--gd-text-secondary); font-size: 0.76rem;">Append-only logging</div>
            </div>
        </div>
    </div>

    <!-- Management Panels -->
    <div class="row g-4">
        <!-- Staff & Department Directory Column -->
        <div class="col-lg-8">
            <div class="card shadow-sm border h-100" style="background-color: var(--gd-bg-card); border-color: var(--gd-border); border-radius: var(--gd-radius-md);">
                <div class="card-header d-flex justify-content-between align-items-center" style="background-color: var(--gd-bg-secondary); border-bottom: 1px solid var(--gd-border);">
                    <span class="fw-semibold text-white small">
                        <i class="bi bi-people me-1" style="color: var(--gd-teal);"></i> Staff & Department Directory
                    </span>
                    <span class="badge" style="background-color: var(--gd-bg-card); border: 1px solid var(--gd-border); color: var(--gd-text-secondary); font-size: 0.68rem;">
                        4 Staff Seeded
                    </span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Staff Member</th>
                                    <th>Assigned Role</th>
                                    <th>Department</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-3">
                                        <strong class="text-white d-block">System Administrator</strong>
                                        <span class="small" style="color: var(--gd-text-muted);">admin@glassdesk.local</span>
                                    </td>
                                    <td><span class="badge badge-teal">Administrator</span></td>
                                    <td style="color: var(--gd-text-secondary);">Central Administration</td>
                                    <td><span class="badge bg-success">Active</span></td>
                                </tr>
                                <tr>
                                    <td class="ps-3">
                                        <strong class="text-white d-block">Verification Officer Tariq</strong>
                                        <span class="small" style="color: var(--gd-text-muted);">verifier@glassdesk.local</span>
                                    </td>
                                    <td><span class="badge badge-indigo">Verification Officer</span></td>
                                    <td style="color: var(--gd-text-secondary);">Central Triage</td>
                                    <td><span class="badge bg-success">Active</span></td>
                                </tr>
                                <tr>
                                    <td class="ps-3">
                                        <strong class="text-white d-block">Engr. Usman (Officer)</strong>
                                        <span class="small" style="color: var(--gd-text-muted);">officer.water@glassdesk.local</span>
                                    </td>
                                    <td><span class="badge bg-secondary">Department Officer</span></td>
                                    <td style="color: var(--gd-text-secondary);">Water and Sanitation</td>
                                    <td><span class="badge bg-success">Active</span></td>
                                </tr>
                                <tr>
                                    <td class="ps-3">
                                        <strong class="text-white d-block">Director Fatima (Supervisor)</strong>
                                        <span class="small" style="color: var(--gd-text-muted);">supervisor.water@glassdesk.local</span>
                                    </td>
                                    <td><span class="badge bg-warning text-dark">Supervisor</span></td>
                                    <td style="color: var(--gd-text-secondary);">Water and Sanitation</td>
                                    <td><span class="badge bg-success">Active</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer small" style="background-color: var(--gd-bg-secondary); border-top: 1px solid var(--gd-border); font-size: 0.76rem; color: var(--gd-text-muted);">
                    <i class="bi bi-shield-check text-teal me-1"></i>
                    <strong>Discussion 19:</strong> Public registration is locked to citizens; only authorized administrators can provision staff accounts.
                </div>
            </div>
        </div>

        <!-- Administrator Quick Actions Column -->
        <div class="col-lg-4">
            <div class="card shadow-sm border h-100" style="background-color: var(--gd-bg-card); border-color: var(--gd-border); border-radius: var(--gd-radius-md);">
                <div class="card-header small fw-semibold text-white" style="background-color: var(--gd-bg-secondary); border-bottom: 1px solid var(--gd-border);">
                    <i class="bi bi-gear-wide me-1" style="color: var(--gd-teal);"></i> Governance Controls
                </div>
                <div class="card-body p-3">
                    <div class="d-grid gap-2">
                        <!-- Action 1: Provision Staff -->
                        <a asp-action="Staff" class="btn btn-outline-primary text-start d-flex align-items-center justify-content-between p-3" style="border-color: var(--gd-border) !important; color: var(--gd-text-primary) !important; background-color: var(--gd-bg-secondary) !important;">
                            <div>
                                <strong class="d-block text-white small"><i class="bi bi-person-plus text-teal me-2"></i> Provision Staff Accounts</strong>
                                <span class="small" style="color: var(--gd-text-muted); font-size: 0.74rem;">Create officers, supervisors, and assign departments.</span>
                            </div>
                            <i class="bi bi-chevron-right small text-muted"></i>
                        </a>

                        <!-- Action 2: Audit Logs -->
                        <a asp-action="AuditLogs" class="btn btn-outline-primary text-start d-flex align-items-center justify-content-between p-3" style="border-color: var(--gd-border) !important; color: var(--gd-text-primary) !important; background-color: var(--gd-bg-secondary) !important;">
                            <div>
                                <strong class="d-block text-white small"><i class="bi bi-shield-lock text-teal me-2"></i> Security & Audit Logs</strong>
                                <span class="small" style="color: var(--gd-text-muted); font-size: 0.74rem;">Inspect append-only security and role events.</span>
                            </div>
                            <i class="bi bi-chevron-right small text-muted"></i>
                        </a>

                        <!-- Action 3: SLA Configuration (Disabled) -->
                        <button class="btn btn-outline-secondary text-start d-flex align-items-center justify-content-between p-3" disabled style="border-color: var(--gd-border) !important; background-color: var(--gd-bg-secondary) !important;">
                            <div>
                                <strong class="d-block small text-muted"><i class="bi bi-clock-history me-2"></i> Configure SLA Targets</strong>
                                <span class="small" style="color: var(--gd-text-muted); font-size: 0.74rem;">Adjust default prototype response targets.</span>
                            </div>
                            <span class="badge" style="background-color: var(--gd-bg-card); font-size: 0.65rem;">Configured</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>