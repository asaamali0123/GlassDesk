@{
    ViewData["Title"] = "System Administration - Glass Desk";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h2 class="fw-bold mb-0 text-dark">System Administration</h2>
                <span class="badge bg-dark px-2 py-1 fs-7">Role: Administrator</span>
            </div>
            <p class="text-muted mb-0 small">Signed in as <strong>@User.Identity?.Name</strong> | Central Administration Console</p>
        </div>
        <div>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                ● System Operational
            </span>
        </div>
    </div>

    <!-- Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 p-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Active Staff Accounts</div>
                <div class="h2 fw-bold text-dark mb-0">5</div>
                <div class="text-success small mt-2">● Seeded & Verified</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 p-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Departments Active</div>
                <div class="h2 fw-bold text-primary mb-0">5</div>
                <div class="text-muted small mt-2">Municipal, Water, Health, Education, Roads</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 p-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">SLA Response Targets</div>
                <div class="h2 fw-bold text-teal mb-0">7 Days</div>
                <div class="text-muted small mt-2">Citizen Review & Closure Rule</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 p-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">System Audit Logs</div>
                <div class="h2 fw-bold text-secondary mb-0">Active</div>
                <div class="text-muted small mt-2">Immutable Log Pipeline</div>
            </div>
        </div>
    </div>

    <!-- Management Panels -->
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 fw-semibold border-bottom">
                    Staff & Department Governance
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Administrators provision staff accounts, assign municipal departments, and enforce role permissions server-side.
                    </p>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Staff Member</th>
                                    <th>Role</th>
                                    <th>Department</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>System Administrator</strong><br /><span class="text-muted">admin@glassdesk.local</span></td>
                                    <td><span class="badge bg-dark">Administrator</span></td>
                                    <td>Central Administration</td>
                                    <td><span class="badge bg-success">Active</span></td>
                                </tr>
                                <tr>
                                    <td><strong>Verification Officer Tariq</strong><br /><span class="text-muted">verifier@glassdesk.local</span></td>
                                    <td><span class="badge bg-info text-dark">Verification Officer</span></td>
                                    <td>Central Triage</td>
                                    <td><span class="badge bg-success">Active</span></td>
                                </tr>
                                <tr>
                                    <td><strong>Engr. Taha (Officer)</strong><br /><span class="text-muted">officer.water@glassdesk.local</span></td>
                                    <td><span class="badge bg-secondary">Department Officer</span></td>
                                    <td>Water and Sanitation</td>
                                    <td><span class="badge bg-success">Active</span></td>
                                </tr>
                                <tr>
                                    <td><strong>Director Fariha (Supervisor)</strong><br /><span class="text-muted">supervisor.water@glassdesk.local</span></td>
                                    <td><span class="badge bg-warning text-dark">Supervisor</span></td>
                                    <td>Water and Sanitation</td>
                                    <td><span class="badge bg-success">Active</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 fw-semibold border-bottom">
                    Administrator Controls
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Staff" class="btn btn-outline-primary text-start">
                            <i class="bi bi-person-plus me-1"></i> + Provision & Manage Staff Accounts
                        </a>
                        <button class="btn btn-outline-secondary text-start" disabled>
                            <i class="bi bi-clock-history me-1"></i> Configure SLA Response Targets
                        </button>
                        <a asp-action="AuditLogs" class="btn btn-outline-secondary text-start">
                            <i class="bi bi-shield-check me-1"></i> View Security & Audit Logs
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>