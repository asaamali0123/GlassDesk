@using GlassDesk.Models
@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Glass Desk</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Civic-Tech Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">

    <!-- Civic Header / Navbar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm py-2" style="background-color: var(--gd-navy); border-bottom: 1px solid rgba(255,255,255,0.08);">
            <div class="container">
                <!-- Brand -->
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white text-decoration-none" asp-controller="Home" asp-action="Index">
                    <span class="badge" style="background-color: var(--gd-teal); font-size: 0.85rem; padding: 0.4rem 0.6rem; letter-spacing: 0.05em;">GD</span>
                    <span class="fs-5 tracking-tight">Glass Desk</span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#civicNavbar" aria-controls="civicNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Links -->
                <div class="collapse navbar-collapse" id="civicNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <!-- Public Portal (Open to All) -->
                        <li class="nav-item">
                            <a class="nav-link text-white-50 px-3" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-globe2 me-1"></i> Public Portal
                            </a>
                        </li>

                        <!-- Role-Specific Direct Links -->
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole(UserRoles.Citizen))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold px-3" asp-controller="Citizen" asp-action="Index">
                                        <i class="bi bi-person-workspace me-1"></i> My Citizen Portal
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole(UserRoles.VerificationOfficer))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold px-3" asp-controller="VerificationOfficer" asp-action="Index">
                                        <i class="bi bi-check2-square me-1"></i> Verification & Triage
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole(UserRoles.DepartmentOfficer))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold px-3" asp-controller="DepartmentOfficer" asp-action="Index">
                                        <i class="bi bi-tools me-1"></i> Department Operations
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole(UserRoles.Supervisor))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold px-3" asp-controller="Supervisor" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-1"></i> Supervisor Oversight
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole(UserRoles.Administrator))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold px-3" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-gear-wide-connected me-1"></i> Admin Console
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- User Account / Authentication Controls -->
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item text-white d-flex align-items-center gap-2 me-2">
                                <span class="small text-white-50 d-none d-md-inline">User:</span>
                                <span class="fw-semibold small">@User.Identity.Name</span>
                                <span class="badge" style="background-color: var(--gd-teal); font-size: 0.75rem;">
                                    @User.FindFirst(ClaimTypes.Role)?.Value
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-light btn-sm px-3" style="font-size: 0.85rem;">
                                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm px-3" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-teal btn-sm px-3 text-white fw-semibold shadow-sm" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Citizen Sign Up
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main role="main" class="flex-grow-1 animate-fade-in">
        @RenderBody()
    </main>

    <!-- Civic Footer -->
    <footer class="mt-auto border-top py-4 text-muted small" style="background-color: #ffffff;">
        <div class="container">
            <div class="row align-items-center gy-3">
                <div class="col-md-6 text-center text-md-start">
                    <div class="fw-semibold text-dark mb-1">
                        <span class="badge bg-secondary-subtle text-dark me-1">Prototype</span> Glass Desk — Municipal Complaint Management Platform
                    </div>
                    <div class="text-muted" style="font-size: 0.82rem;">
                        Transparent, traceable citizen-government service accountability.
                    </div>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <div class="p-2 rounded border bg-light text-secondary d-inline-block text-start" style="font-size: 0.78rem; max-width: 420px;">
                        <i class="bi bi-shield-exclamation text-warning me-1"></i>
                        <strong>Notice:</strong> Glass Desk is a student prototype. In case of immediate physical danger, contact local emergency services.
                    </div>
                </div>
            </div>
            <div class="border-top mt-3 pt-3 text-center text-muted" style="font-size: 0.78rem;">
                &copy; @DateTime.UtcNow.Year Glass Desk. Designed with accessible civic-tech standards.
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>